# Copy this file to .env and fill in your own values. .env is ignored by Git.

# --- Scholarly sources --------------------------------------------------------
# OpenAlex (free key from https://openalex.org/settings/api — required since Feb 2026)
OPENALEX_API_KEY=
# Contact e-mail sent to OpenAlex/Crossref (Crossref "polite pool")
CONTACT_EMAIL=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# --- Language model -----------------------------------------------------------
# groq = hosted (data leaves your computer), ollama = local
LLM_PROVIDER=groq
# auto | json_schema | json_object | none   (auto picks the best mode the provider supports)
LLM_STRUCTURED_MODE=auto
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (https://ollama.com) — run `ollama pull <model>` first
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=300

# --- Storage --------------------------------------------------------------------
# LITAGENT_DB_PATH=data/literature.db
