# Copy this file to .env and fill in your own values. .env is ignored by Git.

# OpenAlex (free key from https://openalex.org/settings/api — required since Feb 2026)
OPENALEX_API_KEY=

# Optional contact e-mail sent to scholarly APIs so they can reach you about problems
CONTACT_EMAIL=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# LLM call behaviour
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Where the SQLite database lives (default: data/literature.db)
# LITAGENT_DB_PATH=data/literature.db
